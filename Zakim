package IRCuser;

# Tracks known IRC users by nick, associating each with the
# username/hostname information collected via WHOIS.

use Socket;

my %Users;

sub new
{
    my ($proto, $nick, $username, $userhost, $fullname) = @_;

    my $class = ref($proto) || $proto;

    my $hostname = undef;

    if ($userhost && (my $hostaddr = inet_aton($userhost))) {
	$hostname = gethostbyaddr(inet_aton($userhost), AF_INET);
    }

    my $self  = {
	'Fullname'	=> $fullname,
	'Hostaddr'	=> $userhost,
	'Hostname'	=> $hostname,
	'Nick'		=> $nick,
	'Username'	=> $username,
    };

    bless ($self, $class);

    $Users{$nick} = $self;

    return $self;
}

# Return a formatted name@addr
sub address
{
    my ($self) = @_;
    my $username = $self->{Username} || '';
    my $hostname = $self->{Hostname} || $self->{Hostaddr} || '';

    return $username.'@'.$hostname;
}

sub fullname
{
    my ($self, $new) = @_;
    $self->{Fullname} = $new if defined $new;
    return $self->{Fullname};
}

sub hostaddr
{
    my ($self, $new) = @_;
    my $old = $self->{Hostaddr} || '';

    if ((defined $new) && ($new ne $old)) {
	if ($new && (my $hostaddr = inet_aton($new))) {
	    $self->{Hostname} = gethostbyaddr(inet_aton($new), AF_INET);
	}
	$self->{Hostaddr} = $new;
    }

    return $self->{Hostaddr};
}

sub hostname
{
    my ($self, $new) = @_;
    $self->{Hostname} = $new if defined $new;
    return $self->{Hostname};
}

sub nick
{
    my ($self, $new) = @_;
    my $old = $self->{Nick};
    if (defined $new) {
	delete $Users{$old};
	$self->{Nick} = $new;
	$Users{$new} = $self;
    }
    return $self->{Nick};
}

sub username
{
    my ($self, $new) = @_;
    $self->{Username} = $new if defined $new;
    return $self->{Username};
}

sub find
{
    my ($searchnick) = @_;
    my $user = $Users{$searchnick};

    unless ($user) {
	$searchnick = lc($searchnick);
	for my $nick (keys %Users) {
	    if (lc($Users{$nick}->{Nick}) eq $searchnick) {
		$user = $Users{$nick};
		last;
	    }
	}
    }

    return $user;
}

